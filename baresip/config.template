#
# baresip configuration template for the COSMIC phone tools.
# Copy to ~/.baresip/config (install.sh does this only if none exists).
#

# Core
poll_method		epoll
sip_trans_def		tcp

# Call
call_local_timeout	120
call_max_calls		4

# Audio
# cosmic-aec-guard rewrites these two lines at service start when
# [aec] enabled = true in phone.conf (to pulse,cosmic_aec_sink / _source).
audio_player		pulse,default
audio_source		pulse,default
audio_alert		pulse,default
audio_level		no
ausrc_format		s16
auplay_format		s16
auenc_format		s16
audec_format		s16
audio_buffer		20-160		# ms

# AVT - Audio/Video Transport
rtp_tos			184
rtcp_mux		no
jitter_buffer_delay	5-10		# frames
rtp_stats		no

#------------------------------------------------------------------------------
# Modules

# Debian/Ubuntu path; other distributions may use /usr/local/lib/baresip/modules
module_path		/usr/lib/baresip/modules

# Audio codecs
module			opus.so
module			g711.so

# Audio driver (PipeWire via pipewire-pulse)
module			pulse.so

# NAT traversal
module			stun.so
module			turn.so
module			ice.so

# Temporary modules
module_tmp		uuid.so
module_tmp		account.so

# Application modules
# Do NOT load stdio.so or cons.so/httpd.so when running under systemd.
module_app		contact.so
module_app		debug_cmd.so
module_app		menu.so
module_app		ctrl_tcp.so

#------------------------------------------------------------------------------
# Module parameters

# ctrl_tcp: the control socket the phone tools use. It accepts unauthenticated
# commands (dial, accept, hangup), so it MUST stay bound to localhost.
# ctrl_tcp's default is 0.0.0.0 - never delete this line.
ctrl_tcp_listen		127.0.0.1:4444

# Opus
opus_bitrate		28000		# 6000-510000

#------------------------------------------------------------------------------
# Call recording - OFF by default.
# Recording calls is regulated; many jurisdictions require every party's
# consent. To enable: uncomment both lines, create the directory, and set the
# same path as [recording] dir in ~/.config/cosmic-tools/phone.conf.
#module			sndfile.so
#snd_path		/home/USER/Recordings/calls
