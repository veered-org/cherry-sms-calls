# ~/.config/cosmic-tools/phone.secrets
#   chmod 600 ~/.config/cosmic-tools/phone.secrets
#
# --- backend = voipms: voip.ms portal > Main Menu > SOAP and REST/JSON API ---
#   1. enable the API
#   2. set an API password (separate from your portal login password)
#   3. add this machine's public IP to the allowed IP list
#      (`cosmic-phone check` prints the IP voip.ms sees)
api_username = you@example.com
api_password = CHANGE_ME

# --- backend = twilio (Twilio Console > Account Info) ---
#twilio_account_sid = ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#twilio_auth_token = CHANGE_ME

# --- backend = signalwire (your Space > API) ---
#signalwire_project_id = xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
#signalwire_api_token = CHANGE_ME

# backend = kdeconnect needs no secrets.
